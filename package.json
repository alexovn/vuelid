{
  "name": "@alexovn/vuelid",
  "type": "module",
  "version": "1.0.0",
  "description": "A tiny validation library for Vue based on Zod.",
  "author": "Nikita Aleksov (https://github.com/alexovn/)",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/alexovn/vuelid.git"
  },
  "bugs": {
    "url": "https://github.com/alexovn/vuelid/issues"
  },
  "homepage": "https://github.com/alexovn/vuelid#readme",
  "keywords": [
    "vue",
    "zod",
    "validation",
    "validate"
  ],
  "exports": {
    ".": {
      "types": "./dist/vuelid.d.ts",
      "import": "./dist/vuelid.js",
      "require": "./dist/vuelid.umd.cjs"
    }
  },
  "main": "./dist/vuelid.umd.cjs",
  "module": "./dist/vuelid.js",
  "types": "./dist/vuelid.d.ts",
  "files": [
    "dist",
    "LICENSE",
    "package.json",
    "README.md"
  ],
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test:unit": "vitest",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "run-s lint:*",
    "lint:oxlint": "oxlint . --fix",
    "lint:eslint": "eslint . --fix --cache",
    "docs:dev": "pnpm --filter docs run docs:dev",
    "docs:build": "pnpm --filter docs run docs:build",
    "docs:preview": "pnpm --filter docs run docs:preview"
  },
  "peerDependencies": {
    "vue": "^3.5.31",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "^7.58.5",
    "@tsconfig/node24": "^24.0.4",
    "@types/jsdom": "^28.0.1",
    "@types/node": "^24.12.0",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vitest/eslint-plugin": "^1.6.13",
    "@vue/eslint-config-typescript": "^14.7.0",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.1.0",
    "eslint-plugin-oxlint": "~1.57.0",
    "eslint-plugin-vue": "~10.8.0",
    "jiti": "^2.6.1",
    "jsdom": "^29.0.1",
    "npm-run-all2": "^8.0.4",
    "oxlint": "~1.57.0",
    "typescript": "^5.9.3",
    "unplugin-dts": "1.0.0-beta.6",
    "vite": "^8.0.3",
    "vite-plugin-vue-devtools": "^8.1.1",
    "vitest": "^4.1.2",
    "vue": "^3.5.31",
    "vue-tsc": "^3.2.6",
    "zod": "^4.3.6"
  },
  "engines": {
    "node": ">=22",
    "pnpm": ">=11"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@11.5.0"
}